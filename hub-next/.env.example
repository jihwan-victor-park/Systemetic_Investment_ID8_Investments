# ── Firestore ────────────────────────────────────────────────────────────────
# On Cloud Run this is inferred from the service account; set explicitly locally.
GCP_PROJECT_ID=molten-crowbar-498920-q8

# Local dev only: point at the Firestore emulator instead of the real project
# (run `npm run emulator` or `firebase emulators:start --only firestore` first).
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ── Auth ─────────────────────────────────────────────────────────────────────
# NextAuth v5, Google provider. Any Google account can sign in (no `hd`
# restriction) — role is decided server-side in src/auth.js's signIn/jwt
# callbacks instead: id8investments.com emails are auto-approved 'internal'
# users; everyone else gets an investorAccess Firestore record created on
# first sign-in and stays gated to /pending until approved from /docs/admin
# (see src/lib/investorAccess.js). Route gate lives in src/middleware.js.
#
# AUTH_SECRET   — random 32+ byte value. Generate with: openssl rand -base64 32
# ALLOWED_HD    — Workspace domain that's auto-approved (defaults to id8investments.com)
#
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET — a Google OAuth 2.0 Web application
# client. Do NOT reuse the existing "ID8 Pipeline" consent screen (it's
# Internal-only, which blocks non-Workspace Google accounts at Google's login
# screen regardless of app logic, and its sensitive Gmail/Drive scopes for n8n
# make it risky to convert to External). Instead, create a new GCP project
# dedicated to this OAuth client, with an External consent screen (scopes:
# openid/email/profile only — non-sensitive, no Google verification needed).
# Authorized redirect URIs needed on the client:
#   http://localhost:3000/api/auth/callback/google        (local dev)
#   https://<production-url>/api/auth/callback/google     (Cloud Run URL, once known)
AUTH_SECRET=
ALLOWED_HD=id8investments.com
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
