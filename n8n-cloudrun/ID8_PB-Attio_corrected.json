    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst newNames = items.filter(item => item.json.is_new).map(item => item.json.company);\n\nconst date = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });\nconst namesList = newNames.length\n  ? newNames.map(n => `<li style=\"margin:0 0 6px 0;font-size:14px;color:#333;\">${n}</li>`).join('')\n  : '<li style=\"margin:0;font-size:14px;color:#888;\">None</li>';\n\nconst html = `<!DOCTYPE html><html><body style=\"margin:0;padding:0;background:#fafafa;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fafafa;padding:48px 0;\"><tr><td align=\"center\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;\"><tr><td>\n  <img src=\"https://id8-137750788450.us-east4.run.app/logo\" alt=\"ID8 Investments\" height=\"22\" style=\"display:block;margin:0 0 20px 0;\">\n  <h1 style=\"margin:0 0 6px 0;font-size:26px;font-weight:700;color:#111;letter-spacing:-0.03em;\">Jesse's Deals \u2014 Daily Update</h1>\n  <p style=\"margin:0 0 28px 0;font-size:14px;color:#888;\">${date} \u2014 the sheet was edited today</p>\n  <p style=\"margin:0 0 4px 0;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#aaa;\">New names added</p>\n  <ul style=\"margin:0 0 24px 0;padding-left:18px;\">${namesList}</ul>\n  <p style=\"margin:0;font-size:12px;color:#b0b0b0;\">ID8 Investments LLC | 169 Hudson Street, New York, NY</p>\n</td></tr></table></td></tr></table></body></html>`;\n\nconst subject = `Jesse Deals \u2014 ${date} (edited, ${newNames.length} new)`;\n\nreturn [{ json: { html, subject, newCount: newNames.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
