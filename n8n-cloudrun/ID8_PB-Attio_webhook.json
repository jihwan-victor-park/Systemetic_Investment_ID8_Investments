    {
      "parameters": {
        "jsCode": "const deals = $input.first().json.deals || [];\nconst date = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });\nif (deals.length === 0) return [{ json: { skip: true } }];\n\nconst clean = v => (v && v !== 'nan' && v !== 'none') ? String(v).trim() : '';\nconst money = v => clean(v) || '—';\n\nconst dealBlocks = deals.map(d => `\n  <tr><td style=\"padding:0 0 40px 0;\">\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td>\n          <a href=\"https://app.attio.com/i-d-8-investments/deals/${d.record_id}\" style=\"text-decoration:none;color:#111;\">\n            <h2 style=\"margin:0 0 3px 0;font-size:21px;font-weight:700;letter-spacing:-0.02em;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">${clean(d.company)}</h2>\n          </a>\n          ${clean(d.website) ? `<p style=\"margin:0 0 12px 0;font-size:13px;\"><a href=\"https://${clean(d.website)}\" style=\"color:#0066cc;text-decoration:underline;\">${clean(d.website)}</a></p>` : ''}\n        </td>\n        <td align=\"right\" style=\"vertical-align:top;padding-top:4px;\">\n          <span style=\"font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#666;background:#ededeb;padding:4px 10px;border-radius:4px;\">${clean(d.series)}</span>\n        </td>\n      </tr>\n    </table>\n    ${clean(d.description) ? `<p style=\"margin:0 0 16px 0;font-size:14px;line-height:1.7;color:#444;\">${clean(d.description)}</p>` : ''}\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:14px;\">\n      <tr>\n        <td style=\"width:33%;padding-right:12px;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">Deal Size</p>\n          <p style=\"margin:0;font-size:16px;font-weight:700;color:#111;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">${money(d.deal_size)}</p>\n        </td>\n        <td style=\"width:33%;padding-right:12px;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">Post Valuation</p>\n          <p style=\"margin:0;font-size:16px;font-weight:700;color:#111;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">${money(d.post_valuation)}</p>\n        </td>\n        <td style=\"width:33%;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">Date</p>\n          <p style=\"margin:0;font-size:16px;font-weight:700;color:#111;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">${clean(d.deal_date) || '—'}</p>\n        </td>\n      </tr>\n    </table>\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom:14px;\">\n      <tr>\n        <td style=\"width:33%;padding-right:12px;vertical-align:top;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">Location</p>\n          <p style=\"margin:0;font-size:13px;color:#444;\">${clean(d.hq_location) || '—'}</p>\n        </td>\n        <td style=\"width:33%;padding-right:12px;vertical-align:top;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">Lead Investors</p>\n          <p style=\"margin:0;font-size:13px;color:#444;\">${clean(d.lead_investors) || '—'}</p>\n        </td>\n        <td style=\"width:33%;vertical-align:top;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">New Investors</p>\n          <p style=\"margin:0;font-size:13px;color:#444;\">${clean(d.new_investors) || '—'}</p>\n        </td>\n      </tr>\n    </table>\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n      <tr>\n        <td style=\"vertical-align:top;\">\n          <p style=\"margin:0 0 2px 0;font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#aaa;\">All Investors</p>\n          <p style=\"margin:0;font-size:13px;color:#444;\">${clean(d.investors) || '—'}</p>\n        </td>\n      </tr>\n    </table>\n  </td></tr>\n  <tr><td style=\"padding:0 0 40px 0;\"><div style=\"height:1px;background:#e4e4e2;\"></div></td></tr>\n`).join('');\n\nconst html = `<!DOCTYPE html>\n<html>\n<body style=\"margin:0;padding:0;background:#fafafa;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#fafafa;padding:48px 0;\">\n  <tr><td align=\"center\">\n    <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;\">\n      <tr><td style=\"padding:0 0 8px 0;\">\n        <img src=\"https://id8-137750788450.us-east4.run.app/logo\" alt=\"ID8 Investments\" height=\"22\" style=\"display:block;margin:0 0 20px 0;\">\n        <h1 style=\"margin:0 0 6px 0;font-size:30px;font-weight:700;color:#111;letter-spacing:-0.03em;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">Weekly Deal Flow</h1>\n        <p style=\"margin:0 0 32px 0;font-size:14px;color:#888;\">${date} &nbsp;·&nbsp; ${deals.length} new deal(s) added to Attio</p>\n        <div style=\"height:1px;background:#e4e4e2;margin-bottom:40px;\"></div>\n      </td></tr>\n      ${dealBlocks}\n      <tr><td style=\"padding:8px 0 0 0;\">\n        <p style=\"margin:0;font-size:12px;color:#b0b0b0;\">ID8 Investments LLC | 169 Hudson Street, New York, NY</p>\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body>\n</html>`;\n\nreturn [{ json: { html, subject: `PitchBook Deal Flow — ${date} (${deals.length} new)` } }];"
      },
